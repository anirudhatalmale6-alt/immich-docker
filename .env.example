# ─── Immich Environment Configuration ─────────────────────────────────────────
# Documentation: https://docs.immich.app/install/environment-variables

# ─── REQUIRED: Change these before first run ──────────────────────────────────

# Where uploaded photos/videos are stored on the host
# Use an absolute path for production (e.g. /mnt/data/immich/library)
UPLOAD_LOCATION=./library

# Where PostgreSQL data is stored on the host
# Must be on a LOCAL disk (network shares are NOT supported for the database)
DB_DATA_LOCATION=./postgres

# PostgreSQL password — change this to something random
# Use ONLY alphanumeric characters (A-Za-z0-9), no special chars or spaces
DB_PASSWORD=CHANGE_ME_TO_SOMETHING_RANDOM

# ─── OPTIONAL: Uncomment and edit as needed ───────────────────────────────────

# Timezone (default: server timezone via /etc/localtime)
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TZ=America/New_York

# Host port for the Immich web UI (default: 2283)
# IMMICH_PORT=2283

# Pin to a specific Immich version (default: latest v2.x)
# Use "release" for absolute latest, or pin like "v2.7.5"
IMMICH_VERSION=v2

# ─── DO NOT CHANGE (unless you know what you're doing) ────────────────────────

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
